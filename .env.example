# noticebox's settings. Copy to .env, fill in, chmod 600, and keep each value in the password manager too.
# A commented line keeps the image's default; uncomment it only to change that.

# The public URL of the inbox: links in notifications and sign-in mails, and the issuer of MCP tokens. Required.
NOTICEBOX_BASE_URL=https://inbox.example.org

# 32 or more random characters that sign sessions and tokens (openssl rand -base64 48). Required.
NOTICEBOX_SECRET=

# Who may sign in: addresses and @domain entries, comma-separated. Empty: nobody.
NOTICEBOX_ALLOWED_EMAILS=you@example.org

# Sign-in by email: a code (and a link) mailed through this SMTP server. Needed unless a provider below is set.
NOTICEBOX_SMTP_URL=smtps://user:password@smtp.example.org:465
NOTICEBOX_SMTP_FROM=noticebox <inbox@example.org>

# Providers to sign in with, one set per <NAME>; each is a button on the sign-in page. Callback URL:
# <NOTICEBOX_BASE_URL>/api/auth/callback/<name in lowercase>. GITHUB and GOOGLE need no _ISSUER.
# NOTICEBOX_OIDC_AUTHENTIK_CLIENT_ID=
# NOTICEBOX_OIDC_AUTHENTIK_CLIENT_SECRET=
# NOTICEBOX_OIDC_AUTHENTIK_ISSUER=https://auth.example.org/application/o/noticebox
# NOTICEBOX_OIDC_AUTHENTIK_LABEL=Example login
# NOTICEBOX_OIDC_GITHUB_CLIENT_ID=
# NOTICEBOX_OIDC_GITHUB_CLIENT_SECRET=

# The SQLite file, with the boxes and forms. Default in the image: /data/noticebox.sqlite
# NOTICEBOX_DB=/data/noticebox.sqlite

# Deprecated: the forms file of releases before 0.16, imported into the database once at the first start, then no
# longer read. Remove it (and this line) once the log says it was imported. Default in the image: /app/noticebox.json
# NOTICEBOX_CONFIG=/data/noticebox.json

# Posts per client address and form in ten minutes; 0 turns the limit off. Default: 10
# NOTICEBOX_RATE_LIMIT=10

# 0 to ignore X-Forwarded-For and take the connecting address. Default: on (the proxy's header is trusted)
# NOTICEBOX_TRUST_PROXY=0

# A fixed name instead of signing in, for development. Refused when NODE_ENV=production, as in the image.
# NOTICEBOX_DEV_USER=dev

# The owner of /data inside the container. Default: the owner of the mounted folder (1000 if that is root)
# PUID=1000
# PGID=1000

# Variables forms reference as ${VAR}, such as ntfy topics, go here too. Saving a form that names an unset one is refused.
# NTFY_REPORTS_TOPIC=
