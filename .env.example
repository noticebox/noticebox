# noticebox's settings. Copy to .env, fill in, chmod 600, and keep each value in the password manager too.
# A commented line keeps the image's default; uncomment it only to change that.

# The public URL of the inbox: links in notifications, and the OAuth issuer for MCP. Required in production.
NOTICEBOX_BASE_URL=https://inbox.example.org

# 32 or more random characters that sign the MCP tokens (openssl rand -base64 48). Unset: no MCP endpoint.
# NOTICEBOX_SECRET=

# The SQLite file, with the boxes and forms. Default in the image: /data/noticebox.sqlite
# NOTICEBOX_DB=/data/noticebox.sqlite

# Deprecated: the forms file of releases before 0.16, imported into the database once at the first start, then no
# longer read. Remove it (and this line) once the log says it was imported. Default in the image: /app/noticebox.json
# NOTICEBOX_CONFIG=/data/noticebox.json

# The header the login proxy sets with the signed-in person's name. Default: X-Authentik-Username
# NOTICEBOX_USER_HEADER=X-Authentik-Username

# Where "Sign out" goes. Default: the Authentik outpost's /outpost.goauthentik.io/sign_out
# NOTICEBOX_SIGN_OUT_URL=/outpost.goauthentik.io/sign_out

# Posts per client address and form in ten minutes; 0 turns the limit off. Default: 10
# NOTICEBOX_RATE_LIMIT=10

# 0 to ignore X-Forwarded-For and take the connecting address. Default: on (the proxy's header is trusted)
# NOTICEBOX_TRUST_PROXY=0

# A fixed name standing in for the login, for development without a proxy. Never in production.
# NOTICEBOX_DEV_USER=dev

# The owner of /data inside the container. Default: the owner of the mounted folder (1000 if that is root)
# PUID=1000
# PGID=1000

# Variables forms reference as ${VAR}, such as ntfy topics, go here too. Saving a form that names an unset one is refused.
# NTFY_REPORTS_TOPIC=
